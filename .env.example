POSTGRES_USER=iatv
POSTGRES_DB=iatv
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://iatv:replace-with-a-local-password@localhost:5432/iatv?schema=public
DATA_MODE=postgres
PORT=3000
# Use o IP da máquina para TV física; 10.0.2.2 para emulador Android.
DEMO_MEDIA_URL=http://10.0.2.2:3000/media/test-pattern.mp4

# Integração de provider (brasiltv permanece indisponível sem contrato validado).
CONTENT_PROVIDER=mock
# PROVIDER_ADMIN_TOKEN deve ser provisionado fora do Git (mínimo 32 caracteres).
# Admin server-only: IATV_BACKEND_URL=http://127.0.0.1:3000
